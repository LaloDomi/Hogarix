DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=servicios_app
# La app Flutter busca el backend en este puerto
PORT=3001
# Obligatorio: cualquier cadena larga y secreta
JWT_SECRET=

# Opcional: carpeta donde se guardan las imágenes subidas (por defecto ./uploads)
UPLOADS_DIR=
# Opcional: URL pública del servidor para armar URLs absolutas de imágenes
# (por defecto se usa el host con el que llega cada petición)
PUBLIC_URL=

# Inicio de sesión con Google: ID(s) de cliente OAuth de Google Cloud,
# separados por coma (web, Android...). Ver GUIA_LOGIN_SOCIAL.md
GOOGLE_CLIENT_IDS=

# Inicio de sesión con Facebook: datos de tu app en developers.facebook.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Correos (códigos para restablecer contraseña y entrar con Gmail) ---
# Usa la API de Brevo (gratis, 300 correos/día). Render gratis bloquea SMTP.
# 1) Crea cuenta en brevo.com  2) Senders: verifica tu Gmail como remitente
# 3) SMTP & API > API Keys > crea una clave
BREVO_API_KEY=
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=Hogarix
# Solo para probar en local sin Brevo: el código se imprime en esta consola.
CORREO_MODO_PRUEBA=false

# --- Inteligencia artificial (asistente y "Mejorar con IA") ---
# Por defecto Groq (gratis, sin tarjeta): console.groq.com/keys
IA_API_KEY=
IA_API_URL=https://api.groq.com/openai/v1/chat/completions
# Modelos que da Groq a cuentas nuevas: openai/gpt-oss-120b u openai/gpt-oss-20b
IA_MODELO=openai/gpt-oss-120b
